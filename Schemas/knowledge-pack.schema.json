{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trailguard.app/schemas/knowledge-pack.schema.json",
  "title": "Aurora knowledge pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "version", "domain", "locale", "license", "review", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["vehicle", "wilderness", "first_aid", "navigation", "resilience"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "region": { "type": ["string", "null"] },
    "effective_date": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "permitted_uses", "source_manifest_path"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "permitted_uses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "source_manifest_path": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority_role", "reviewed_at", "attestation_id"],
      "properties": {
        "status": { "enum": ["development_fixture", "approved", "recalled"] },
        "authority_role": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "attestation_id": { "type": "string", "minLength": 1 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "title", "summary", "steps", "warnings", "keywords", "source", "applicability", "supported_answer_level"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "title", "owner", "revision", "locator"],
            "properties": {
              "source_id": { "type": "string" },
              "title": { "type": "string" },
              "owner": { "type": "string" },
              "revision": { "type": "string" },
              "locator": { "type": "string" }
            }
          },
          "applicability": { "type": "object" },
          "supported_answer_level": { "enum": ["supported", "limited", "insufficient", "prohibited", "critical"] },
          "embedding": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4
          }
        }
      }
    }
  }
}
