{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trailguard.app/schemas/policy.schema.json",
  "title": "TrailGuard safety policy pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "effective_at", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "effective_at": { "type": "string", "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "domain", "severity", "triggers", "action", "prohibited_actions", "source_id"],
        "properties": {
          "policy_id": { "type": "string", "minLength": 1 },
          "domain": { "enum": ["global", "vehicle", "wilderness", "first_aid", "navigation"] },
          "severity": { "enum": ["informational", "caution", "urgent", "critical"] },
          "triggers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "action": { "type": "string", "minLength": 1 },
          "prohibited_actions": { "type": "array", "items": { "type": "string" } },
          "source_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
